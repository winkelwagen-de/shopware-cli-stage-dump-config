#!/usr/bin/env php
<?php

declare(strict_types=1);

use ShopwareGdprDump\Build\DumpConfigBuilder;
use Symfony\Component\Yaml\Yaml;

require dirname(__DIR__) . '/vendor/autoload.php';

$projectRoot = dirname(__DIR__);
$checkOnly = \in_array('--check', $argv, true);

try {
    $builder = new DumpConfigBuilder($projectRoot);
    $built = $builder->build();

    $distDir = $projectRoot . '/dist';
    if (!is_dir($distDir) && !mkdir($distDir, 0755, true) && !is_dir($distDir)) {
        throw new RuntimeException('Unable to create dist/ directory');
    }

    $distFile = $distDir . '/shopware-gdpr-dump.yml';

    if ($checkOnly) {
        if (!is_file($distFile)) {
            fwrite(STDERR, "dist/shopware-gdpr-dump.yml is missing — run bin/build-dump-config and commit the result\n");
            exit(1);
        }

        $current = (string) file_get_contents($distFile);
        if (normalizeDumpYaml($current) !== normalizeDumpYaml($built)) {
            fwrite(STDERR, "dist/shopware-gdpr-dump.yml is out of date — run bin/build-dump-config and commit the result\n");
            exit(1);
        }
        fwrite(STDOUT, "dist/shopware-gdpr-dump.yml is up to date.\n");
        exit(0);
    }

    file_put_contents($distFile, $built);

    fwrite(STDOUT, "Wrote dist/shopware-gdpr-dump.yml\n");
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

function normalizeDumpYaml(string $yaml): string
{
    $parsed = Yaml::parse($yaml);

    return Yaml::dump($parsed, 6, 2, Yaml::DUMP_EMPTY_ARRAY_AS_SEQUENCE);
}
