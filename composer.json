{
    "name": "winkelwagen/shopware-gdpr-dump",
    "description": "Community GDPR dump config for shopware-cli (plugin tables only)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/yaml": "^7.0|^6.4"
    },
    "autoload": {
        "psr-4": {
            "ShopwareGdprDump\\": "src/"
        }
    },
    "bin": [
        "bin/build-dump-config",
        "bin/check-dist-not-changed",
        "bin/scan-plugin-migrations",
        "bin/cleanup-plugin-config",
        "bin/validate-dump-config"
    ],
    "extra": {
        "shopware-gdpr-dump": {
            "config-file": "dist/shopware-gdpr-dump.yml"
        }
    },
    "homepage": "https://github.com/winkelwagen-de/shopware-cli-stage-dump-config",
    "support": {
        "source": "https://github.com/winkelwagen-de/shopware-cli-stage-dump-config"
    },
    "archive": {
        "exclude": [
            "tests",
            ".github",
            "plugins",
            "config",
            "schema",
            "bin",
            "src"
        ]
    }
}
