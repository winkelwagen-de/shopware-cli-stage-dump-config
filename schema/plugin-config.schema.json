{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin GDPR dump config (authoring format)",
  "type": "object",
  "required": ["plugin"],
  "additionalProperties": false,
  "properties": {
    "plugin": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "maintainer": { "type": "string" }
      }
    },
    "dump": {
      "type": "object",
      "required": ["tables"],
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rewrite": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "nodata": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
